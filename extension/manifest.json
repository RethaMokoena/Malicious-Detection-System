{
  "manifest_version": 3,
  "name": "Malicious Detection System",
  "version": "1.0",
  "description": "Detect malicious URLs and phishing emails in real-time.",
  "permissions": ["tabs", "notifications", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ]
}
